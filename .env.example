# 环境变量样例
# 复制为 .env 后填写真实值。.env 严禁入仓。

# ---------------------------------------------------------------- 应用
APP_ENV=dev
# 注意：该值不会被传给 FastAPI(debug=...)（debug 会绕过异常处理器并泄漏堆栈），
# 仅供后续需要区分 dev 行为时使用，默认保持 false
APP_DEBUG=false
# 签名密钥（访问令牌/刷新令牌的唯一来源）：长度必须 ≥ 32 字符，否则拒绝启动。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-change-me-0123456789abcdefghij
# 后端监听端口
APP_PORT=8000
# 前端 dev server 地址，用于 CORS
APP_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ragagent
# 集成/迁移测试专用库（独立于开发库，避免污染）
MYSQL_TEST_DATABASE=ragagent_test
# SQLAlchemy URL（如留空则由上面各字段拼装）
# MYSQL_URL=mysql+pymysql://root:pass@127.0.0.1:3306/ragagent

# ---------------------------------------------------------------- Redis / Celery
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

# ---------------------------------------------------------------- Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
# 项目级隔离：所有 collection 建在此 database 下
MILVUS_DATABASE=ragagent
MILVUS_COLLECTION=kb_chunks
# KB 级隔离：partition key 字段名
MILVUS_PARTITION_KEY=kb_id

# ---------------------------------------------------------------- 日志与健康检查
LOG_LEVEL=INFO
# 单个依赖组件探测超时（秒）
HEALTH_CHECK_TIMEOUT_SEC=2

# ---------------------------------------------------------------- DashScope
DASHSCOPE_API_KEY=
# OpenAI 兼容模式 base_url（华北2 北京；需替换 WorkspaceId）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生成模型
DASHSCOPE_CHAT_MODEL=qwen-plus
# 向量模型（1024 维；批量上限 20 条/次；单行 128k token）
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBED_DIM=1024
DASHSCOPE_EMBED_BATCH_SIZE=20
# 重排模型（二期，开关关闭时可留空）
DASHSCOPE_RERANK_MODEL=gte-rerank-v2

# ---------------------------------------------------------------- MinerU
# cloud = 云 API (mineru.net /api/v4)；local = 本地 mineru-api 服务
MINERU_PROVIDER=cloud
# cloud 模式：在 https://mineru.net/apiManage 申请
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
# 解析模型：vlm（推荐，精度高）/ pipeline
MINERU_MODEL_VERSION=vlm
# local 模式：本地 mineru-api 地址（端口 8001）
MINERU_LOCAL_URL=http://127.0.0.1:8001
# 轮询解析结果
MINERU_POLL_INTERVAL_SEC=5
MINERU_POLL_TIMEOUT_SEC=900

# ---------------------------------------------------------------- 文件存储
# local = 本地文件系统；minio = 对象存储
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
# STORAGE_MINIO_ENDPOINT=127.0.0.1:9000
# STORAGE_MINIO_ACCESS_KEY=minioadmin
# STORAGE_MINIO_SECRET_KEY=minioadmin
# STORAGE_MINIO_BUCKET=ragagent

# ---------------------------------------------------------------- 认证与令牌
# 签名密钥统一取上面的 APP_SECRET_KEY（不再单独配置 JWT_SECRET_KEY，避免两把密钥并存）
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MIN=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 刷新令牌只经 HttpOnly Cookie 传递；Path 必须同时覆盖刷新与登出端点（见 design D3）
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# 本地 http 环境保持 false；生产（https）必须改为 true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# 初始管理员引导：仅当账号表为空时生效。创建成功后建议清空这两行，避免明文留档。
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 切分（默认值，可被 KB 配置覆盖）
CHUNK_TARGET_TOKENS_TEXT=512
CHUNK_MAX_TOKENS_TEXT=768
CHUNK_TARGET_TOKENS_TABLE=1024
CHUNK_MAX_TOKENS_TABLE=2048
CHUNK_TARGET_TOKENS_CODE=768
CHUNK_TARGET_TOKENS_LIST=512
CHUNK_OVERLAP_ENABLED=false
CHUNK_OVERLAP_RATIO=0.10
CHUNK_CONTEXTUAL_ENABLED=false
CHUNK_PARENT_CHILD_ENABLED=true
CHUNK_PARENT_MAX_TOKENS=2048
CHUNK_TOKENIZER=tiktoken_cl100k
CHUNK_TOKEN_SAFETY_FACTOR=1.15

# ---------------------------------------------------------------- 检索
RETRIEVAL_TOP_K=50
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_TOP_N=5
RETRIEVAL_SPARSE_ENABLED=false
# 相似度下限（低于此值视为未命中）
RETRIEVAL_MIN_SCORE=0.30

# ---------------------------------------------------------------- 图片 / 公式
# off = 丢弃；caption = 保留图注 + 占位（默认）；vlm = 额外生成图片描述
IMAGE_MODE=caption
# 是否保留 LaTeX 公式原文
KEEP_EQUATION=true

# ---------------------------------------------------------------- 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_USER_MIN=20
RATE_LIMIT_UPLOAD_PER_USER_MIN=30
# 登录失败限流：同一「用户名 + 来源地址」在窗口内失败达阈值即返回 429
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# ---------------------------------------------------------------- 观测（LangSmith，默认关闭）
# 观测为非生产链路必需依赖：关闭时不产生任何外发请求；上报失败不影响业务链路。
# 采用 SDK 原生 LANGSMITH_* 变量名（单一来源）。生效条件：TRACING=true 且 ENDPOINT/API_KEY 齐全。
# 未配置或留空 = 视为关闭，应用正常启动。
#LANGSMITH_TRACING=false
# 观测后端地址：SaaS（https://api.smith.langchain.com）或自托管（Langfuse / LangSmith 自托管）
# 注意：开启观测后，用户问题与召回内容会发往该地址——企业部署请评估数据流向
#LANGSMITH_ENDPOINT=
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=ragagent
# 可选：后台上报超时（毫秒），收敛不可达后端时的后台重试窗口
#LANGSMITH_TIMEOUT_MS=
